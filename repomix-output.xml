    const interactPlugin = mockCreateInteractPlugin.mock.results[0].value

    mapReadyHandler({ map: mockNativeMap })

    expect(interactPlugin.enable).toHaveBeenCalled()
    expect(mockAddPanel).toHaveBeenCalledWith(
