}

const sampleFeatureProperties = {
  OBJECTID: 42,
  Town: 'Wrexham',
  District: 'Wrexham',
  County: 'Wrexham County Borough Council',
  Country: 'Wales',
  Date_collected: 1634428800000,
  Species: 'Pheasant',
  Test_date: 1635379200000,
  Virus_Isolated: 'H5N1',
  High_Path: 'yes',
  Season: 21
}

const rasterOverlayPayload = {
